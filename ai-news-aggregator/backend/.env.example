PORT=5000
OLLAMA_URL=http://localhost:11434/api/generate
# mistral (7B) needs ~4-5GB free RAM to load. If summaries fail with a 500 and
# the backend log shows "model requires more system memory than is available",
# switch to a lighter model that fits your machine, e.g.:
#   ollama pull qwen2.5:1.5b
SUMMARIZE_MODEL=mistral
TRANSLATE_MODEL=mistral
SUMMARY_INPUT_LIMIT=240

# If you add any third-party API keys later, keep them only in .env
# Example:
# NEWS_API_KEY=your_api_key_here
